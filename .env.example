# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略
# 必填：同花顺金融数据（扶摇）API Key，在 https://fuyao.aicubes.cn/admin 签发
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# 必填（否则自动降级为纯数据底稿）：DeepSeek，OpenAI 兼容接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选：分别指定 Agent 取证与撰写所用模型
# AGENT_MODEL=
# WRITER_MODEL=

# 可选：iFinD MCP（新闻检索，作为第二数据源）；不填时 Agent 的新闻工具会返回失败并继续
IFIND_MCP_BASE=https://api-mcp.51ifind.com:8643/ds-mcp-servers
IFIND_MCP_TOKEN=

# 可选：每个 IP 每小时最多生成次数（控制演示成本），默认 8
# RUNS_PER_IP_PER_HOUR=8
# PORT=3000
